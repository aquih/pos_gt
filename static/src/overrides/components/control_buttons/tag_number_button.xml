<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_sale.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
            <button t-att-class="buttonClass" t-on-click="() => this.clickTagNumber()">
                <t t-if="pos.get_order().tag_number &gt; -1">
                    <i class='fa fa-tag' /> <t t-esc="pos.get_order().tag_number" />
                </t>
                <t t-if="!pos.get_order().tag_number">
                    <i class='fa fa-tag' /> Etiqueta
                </t>
            </button>
        </xpath>
    </t>

</templates>