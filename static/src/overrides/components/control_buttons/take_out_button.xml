<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_sale.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
            <button t-att-class="buttonClass" t-on-click="() => this.clickTakeOut()">
                <t t-if="pos.get_order().take_out">
                    <i class='fa fa-shopping-bag' /> Llevar
                </t>
                <t t-if="!pos.get_order().take_out">
                    <i class='fa fa-shopping-bag' /> Restaurante
                </t>
            </button>
        </xpath>
    </t>

</templates>