<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reporte_cierre">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Cierre de caja: <span t-esc="', '.join([x.name for x in docs])"/></h2>

                    <h4>Efectivo</h4>

                    <table class="table table-sm mb4">
                        <tbody>
                            <tr>
                                <td class="text-end">
                                    Inicial
                                </td>
                                <td class="text-end">
                                    Transacciones
                                </td>
                                <td class="text-end">
                                    Esperado
                                </td>
                                <td class="text-end">
                                    Actual
                                </td>
                                <td class="text-end">
                                    Diferencia
                                </td>
                            </tr>
                            <tr>
                                <td class="text-end">
                                    <span t-esc="sum([x.cash_register_balance_start for x in docs])" t-options='{"widget": "monetary", "display_currency": current_company_id.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="total_efectivo(docs)" t-options='{"widget": "monetary", "display_currency": current_company_id.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="sum([x.cash_register_balance_end for x in docs])" t-options='{"widget": "monetary", "display_currency": current_company_id.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="sum([x.cash_register_balance_end_real for x in docs])" t-options='{"widget": "monetary", "display_currency": current_company_id.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="sum([x.cash_register_difference for x in docs])" t-options='{"widget": "monetary", "display_currency": current_company_id.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>


                    <h4>Total de ingresos</h4>

                    <table class="table table-sm mb4">
                        <thead>
                            <tr>
                                <th>
                                    Métod de pago
                                </th>
                                <th class="text-end">
                                    Total
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="lineas_ingresos(docs)" t-as="linea">
                                <td><span t-esc="linea['metodo'].name"/></td>
                                <td class="text-end">
                                    <span t-esc="linea['total']" t-options='{"widget": "monetary", "display_currency": current_company_id.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td></td>
                                <td class="text-end">
                                    <span t-esc="total_ingresos(docs)" t-options='{"widget": "monetary", "display_currency": current_company_id.currency_id}'/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <h4>Total de egresos</h4>

                    <table class="table table-sm mb4">
                        <thead>
                            <tr>
                                <th>
                                    Diario
                                </th>
                                <th class="text-end">
                                    Total
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="lineas_egresos(docs)" t-as="linea">
                                <td><span t-esc="linea['diario'].name"/></td>
                                <td class="text-end">
                                    <span t-esc="linea['total']" t-options='{"widget": "monetary", "display_currency": current_company_id.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td></td>
                                <td class="text-end">
                                    <span t-esc="total_egresos(docs)" t-options='{"widget": "monetary", "display_currency": current_company_id.currency_id}'/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <h4>Total de ventas:</h4>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Numero</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Factura</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="lineas_ventas(docs)" t-as="order">
                                <td><span t-field="order.name"/></td>
                                <td><span t-field="order.date_order"/></td>
                                <td><span t-field="order.partner_id"/></td>
                                <td><span t-field="order.account_move.name"/></td>
                                <td class="text-end">
                                    <span t-field="order.amount_total" t-options='{"widget": "monetary", "display_currency": order.pricelist_id.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="text-end">
                                    <span t-esc="total_ventas(docs)" t-options='{"widget": "monetary", "display_currency": current_company_id.currency_id}'/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
